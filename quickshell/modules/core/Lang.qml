    function t(key, vars) {
        const activeMap = root.dict[root.lang] || root.dict.en;
        let str = (activeMap && activeMap[key] !== undefined) ? activeMap[key] : (root.dict.en[key] !== undefined ? root.dict.en[key] : key);
        if (vars) {
            for (const k in vars)
                str = str.split("{" + k + "}").join(String(vars[k]));
        }
        return str;
    }

    function tp(baseKey, count, vars) {
        const n = Math.abs(Math.floor(count || 0));
        let suffix = "_other";
        if (root.lang === "ru") {
            const mod10 = n % 10;
            const mod100 = n % 100;
            if (mod10 === 1 && mod100 !== 11)
                suffix = "_one";
            else if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14))
                suffix = "_few";
            else
                suffix = "_many";
        } else {
            suffix = (n === 1) ? "_one" : "_other";
        }
        const merged = Object.assign({
            n: count
        }, vars || {});
        const activeMap = root.dict[root.lang] || root.dict.en;
        if (activeMap && activeMap[baseKey + suffix] !== undefined)
            return root.t(baseKey + suffix, merged);
        if (activeMap && activeMap[baseKey + "_other"] !== undefined)
            return root.t(baseKey + "_other", merged);
        if (root.dict.en[baseKey + suffix] !== undefined)
            return root.t(baseKey + suffix, merged);
        return root.t(baseKey + "_other", merged);
    }
}
